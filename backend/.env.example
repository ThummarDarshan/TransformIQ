# Environment
ENVIRONMENT=development

# Database (Default zero-config SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./transformiq.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/transformiq_db

# Security & JWT
JWT_SECRET=transformiq-super-secret-jwt-key-for-chaos2commit-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider (Options: auto, gemini, deterministic_smart)
AI_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
