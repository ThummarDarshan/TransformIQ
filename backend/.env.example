# Environment & Server
ENVIRONMENT=development
DEBUG=true

# Database (Production: PostgreSQL, Local Development: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./transformiq.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/transformiq

# Authentication & JWT
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Management & Routing
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,groq,openrouter,openai,azure
AI_ROUTING_STRATEGY=health_round_robin
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=60
AI_COOLDOWN_SECONDS=60
AI_MAX_MESSAGE_LENGTH=12000
AI_MAX_OUTPUT_TOKENS=4096

# Free-First AI Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional Fallback Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Multilingual Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,gu

# Chat & Memory
CHAT_HISTORY_ENABLED=true
CHAT_AUTO_TITLE_ENABLED=true
CHAT_PROJECT_CONTEXT_ENABLED=true
CHAT_RAG_ENABLED=true
VECTOR_SEARCH_ENABLED=true

# Rate Limiting Guardrails
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=5
WEBSITE_INGEST_RATE_LIMIT_PER_MINUTE=3

# Testing & Error Simulation (Development Only)
AI_TEST_FORCE_PROVIDER_ERROR=
